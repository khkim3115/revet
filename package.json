{
  "name": "@khkim3115/revet",
  "version": "0.1.5",
  "description": "Guardrails for AI coding agents on legacy codebases",
  "license": "MIT",
  "author": "Kwanghwi Kim (https://github.com/khkim3115)",
  "homepage": "https://github.com/khkim3115/revet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khkim3115/revet.git"
  },
  "bugs": {
    "url": "https://github.com/khkim3115/revet/issues"
  },
  "keywords": [
    "claude-code",
    "agent",
    "hooks",
    "guardrails",
    "legacy",
    "linter",
    "static-analysis",
    "ai-safety"
  ],
  "type": "module",
  "bin": {
    "revet": "dist/revet.cjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "packs",
    "docs",
    "README.md",
    "README.ko.md",
    "CLEANROOM.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.6.0",
    "vitest": "^3.2.7",
    "yaml": "^2.5.0"
  },
  "scripts": {
    "compile:packs": "node scripts/compile-packs.mjs",
    "build": "npm run compile:packs && node esbuild.config.mjs",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "vitest run test/perf.bench.ts",
    "lint:cleanroom": "node scripts/cleanroom-check.mjs"
  }
}
